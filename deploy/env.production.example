# AutoML-Lens production environment template.
#
# Installed to /etc/automl-lens.env on the server and loaded by
# deploy/systemd/automl-lens.service. THIS FILE IS A TEMPLATE AND CONTAINS NO
# SECRETS - the real file lives only on the server (chmod 640, never committed).
#
# Every value here is also honoured as a plain environment variable, so a container
# or PaaS platform can inject them instead of using this file.

# ── LLM provider ─────────────────────────────────────────────────────────────
# 'gemini' | 'openai' | 'fallback'
# 'fallback' is fully functional, deterministic and needs NO key and NO internet.
LLM_PROVIDER=fallback

# Google Gemini (https://aistudio.google.com/apikey). Leave empty unless gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI-compatible endpoint (optional, used only when LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Must list the exact FRONTEND origin(s) that will call this API (not the API's own
# domain). No wildcards: CORS credentials are enabled. Examples:
#   https://your-app.vercel.app
#   https://automl-lens.example
# Comma-separate for several origins.
CORS_ORIGINS=https://REPLACE-WITH-YOUR-FRONTEND-ORIGIN.example

# ── Persistence ───────────────────────────────────────────────────────────────
# Relative paths resolve inside backend/. Keep both on the persistent volume:
# DATABASE_URL holds datasets/experiments/models/reports metadata,
# STORAGE_PATH holds the uploaded files and trained model artifacts.
DATABASE_URL=sqlite:///./automl_lens.db
STORAGE_PATH=./storage

# ── Upload limit ─────────────────────────────────────────────────────────────
# 1024 MB = 1 GB. nginx must allow at least this (client_max_body_size 2048m)
# and any CDN/proxy in front of the app must not impose a smaller body limit.
MAX_DATASET_SIZE_MB=1024