# AutoML-Lens Environment Configuration
#
# COPY THIS FILE:   cd backend && cp .env.example .env
#
# This is the file the application actually reads. backend/app/core/config.py
# loads ENV_FILE = backend/.env, so a .env placed anywhere else is ignored.
# Relative paths below resolve inside backend/.

# LLM Provider: 'gemini', 'openai', or 'fallback'
# 'fallback' is fully functional and needs no key or internet access.
LLM_PROVIDER=fallback

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
# Only read when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI-compatible API (optional)
# Only read when LLM_PROVIDER=openai. Set OPENAI_BASE_URL for any
# OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true

# Storage (relative values resolve inside backend/)
STORAGE_PATH=./storage
DATABASE_URL=sqlite:///./automl_lens.db